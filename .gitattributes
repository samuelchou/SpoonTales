###############################################################################
# 1. 換行符號規範 (與 .editorconfig 配合)
###############################################################################
* text=auto eol=lf

*.cs text diff=csharp
# 強制 Windows 格式 (關鍵 Unity 資源)
*.sln text eol=crlf
*.csproj text eol=crlf
*.unity text eol=crlf 
*.prefab text eol=crlf
*.asset text eol=crlf
ProjectSettings/**/*.asset -merge
*.meta text eol=crlf
*.controller text eol=crlf
*.mat text eol=crlf
*.anim text eol=crlf

###############################################################################
# 2. 二進位檔案保護 (防止損毀)
###############################################################################
*.jpg binary
*.png binary
*.tga binary
*.psd binary
*.fbx binary
*.obj binary
*.a binary
*.so binary
*.dll binary
